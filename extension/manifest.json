{
  "manifest_version": 3,
  "name": "XI Lab capture",
  "version": "0.4.1",
  "description": "Copies what the EA FC Web App already shows you, for XI Lab: transfer-market prices from your own searches, and your club when you open it. Optional slow price check for your own cards, and optional upload to your Gaffer Bot account. Never bids, buys, lists or moves anything.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XI Lab capture"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/*ultimate-team/web-app*"
      ],
      "js": [
        "dist/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.ea.com/*ultimate-team/web-app*"
      ],
      "js": [
        "dist/relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://gafferbot.app/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  }
}
