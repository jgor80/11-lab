{
  "name": "xi-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XI Lab: chemistry-aware FUT squad optimizer. Data model, import pipeline, chemistry engine and the squad workspace.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "db:migrate": "tsx scripts/migrate.ts",
    "fetch:ea": "tsx scripts/fetch-ea-ratings.ts",
    "import": "tsx scripts/import.ts",
    "export:d1": "tsx scripts/export-d1.ts",
    "market": "tsx scripts/market.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^6.3.5",
    "vitest": "3.2.4"
  }
}
